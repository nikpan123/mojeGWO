    "test:services:list": "node scripts/run.mjs test:services --list",
    "test:pages": "node scripts/run.mjs test:pages",
    "test:pages:list": "node scripts/run.mjs test:pages --list",
    "check:auth": "node checks/auth.test.mjs",

{
  "name": "moje-gwo-test-healthcheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth": "node scripts/save-session.mjs",
    "auth:check": "node scripts/check-auth.mjs",
    "auth:force": "node scripts/check-auth.mjs --force",
    "panel": "node dashboard/server.mjs",
    "check:dashboard": "node checks/dashboard.test.mjs",
    "check:auth": "node checks/auth.test.mjs",
    "check:config": "node scripts/check-config.mjs",
